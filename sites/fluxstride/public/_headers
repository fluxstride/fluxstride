# Cloudflare reads this file from the build output and applies it at the edge.
# Rules are cumulative: every matching block is applied.

# Vite fingerprints these filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names across swaps, so cache for a week only.
/images/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
