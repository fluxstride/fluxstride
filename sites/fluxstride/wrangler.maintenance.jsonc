{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Same worker as wrangler.jsonc, with worker/maintenance.mjs answering every request.
  // Deploy with `pnpm cf:maintenance`; `pnpm cf:deploy` puts the normal site back.
  "name": "fluxstride-website",
  "compatibility_date": "2026-09-16",
  "main": "./worker/maintenance.mjs",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the worker before static files, so page URLs get the maintenance page.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },

  "observability": {
    "enabled": true,
  },
}
