{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fluxstride-website",
  "compatibility_date": "2026-09-16",

  // No "main" worker script: this is a static site, so Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist",
    // Every route is prerendered to its own HTML file, so an unknown path is
    // genuinely missing. Serve the prerendered 404.html with a real 404 status
    // rather than the home page with a 200 (a soft 404, which search engines penalise).
    "not_found_handling": "404-page",
    // /work/ redirects to /work, matching the canonical URLs in src/lib/seo.ts.
    "html_handling": "drop-trailing-slash",
  },

  "observability": {
    "enabled": true,
  },
}
