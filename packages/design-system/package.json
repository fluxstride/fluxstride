{
  "name": "@fluxstride/design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tokens, fonts, motion, UI primitives and helpers shared by every Fluxstride site. Consumed as source; there is no build step.",
  "exports": {
    "./styles/*": "./styles/*",
    "./lib/*": "./src/lib/*.ts",
    "./motion/*": "./src/motion/*.tsx",
    "./ui/*": "./src/ui/*.tsx"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "react": "^19.3.0"
  }
}
